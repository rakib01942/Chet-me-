{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique global ID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "badge": { "type": "string", "enum": ["NORMAL", "ADMIN", "EMPLOYEE", "VERIFIED", "VIP", "CONTRIBUTOR", "POPULAR", "PRO", "WARNING"] },
        "uidPrivacy": { "type": "boolean", "description": "Global search visibility" },
        "bannedUntil": { "type": "string", "format": "date-time" },
        "isPermanentlyBanned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Individual or group chat session",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["individual", "group"] },
        "name": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "participants": { "type": "array" }
      },
      "required": ["type", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "video", "file", "call"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array" }
      },
      "required": ["senderId", "text", "type", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Temporary status update",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "video"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "type", "createdAt", "expiresAt"]
    },
    "Call": {
      "title": "Call",
      "description": "Voice call record",
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["missed", "accepted", "rejected"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["from", "to", "type", "startedAt"]
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Connection request between users",
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["from", "to", "status", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Admin broadcast notice",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "body", "createdAt", "isActive"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat metadata"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat"
    },
    "stories/{storyId}": {
      "schema": "Story",
      "description": "User stories"
    },
    "calls/{callId}": {
      "schema": "Call",
      "description": "Call records"
    },
    "friendRequests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Friend requests"
    },
    "notices/{noticeId}": {
      "schema": "Notice",
      "description": "Admin notices"
    }
  }
}
